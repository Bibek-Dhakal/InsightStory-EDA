# Copy to .env (never commit .env). Relative paths resolve against the project root.
INSIGHTSTORY_DB_PATH=data/insightstory.duckdb
INSIGHTSTORY_OUTPUT_DIR=outputs
INSIGHTSTORY_SQL_DIR=sql

# Synthetic data generation
INSIGHTSTORY_SEED=42
INSIGHTSTORY_N_CUSTOMERS=5000
INSIGHTSTORY_N_PRODUCTS=150
INSIGHTSTORY_START_DATE=2024-01-01
INSIGHTSTORY_END_DATE=2025-12-31

# Analysis settings (as-of date defaults to the end date)
INSIGHTSTORY_AS_OF_DATE=
INSIGHTSTORY_CHURN_DAYS=90
